<div class="travel-log">
  {% if site.data.conferences %}
    {% assign today = "now" | date: "%s" | plus: 0 %}
    {% assign upcoming = "" | split: "" %}
    {% assign past = "" | split: "" %}
    
    <!-- Separate conferences into upcoming and past based on start_date -->
    {% for conference in site.data.conferences %}
      {% assign conf_date = conference.start_date | date: "%s" | plus: 0 %}
      {% if conf_date >= today %}
        {% assign upcoming = upcoming | push: conference %}
      {% else %}
        {% assign past = past | push: conference %}
      {% endif %}
    {% endfor %}
    
    <!-- Upcoming Travel Section (collapsible details) -->
    {% if upcoming.size > 0 %}
      <div class="upcoming-travel">
        <h3>Upcoming Conferences</h3>
        <div class="conference-list">
          {% assign upcoming_sorted = upcoming | sort: 'start_date' %}
          <ul class="conference-names">
            {% for conf in upcoming_sorted %}
              <li>
                <details class="conference-detail">
                  <summary>
                    {% if conf.url %}
                      <a href="{{ conf.url }}" target="_blank">{{ conf.name }}</a>
                    {% else %}
                      {{ conf.name }}
                    {% endif %}
                    <span class="conference-mini-date"> — 
                      {% if conf.end_date %}
                        {% if conf.start_date | date: '%Y%m%d' == conf.end_date | date: '%Y%m%d' %}
                          {{ conf.start_date | date: '%b %d, %Y' }}
                        {% else %}
                          {{ conf.start_date | date: '%b %d' }} – {{ conf.end_date | date: '%b %d, %Y' }}
                        {% endif %}
                      {% else %}
                        {{ conf.start_date | date: '%b %d, %Y' }}
                      {% endif %}
                    </span>
                  </summary>
                  <div class="conference-details">
                    <p><strong>Dates:</strong> 
                      {% if conf.start_date | date: '%Y%m%d' == conf.end_date | date: '%Y%m%d' %}
                        {{ conf.start_date | date: '%b %d, %Y' }}
                      {% else %}
                        {{ conf.start_date | date: '%b %d, %Y' }} – {{ conf.end_date | date: '%b %d, %Y' }}
                      {% endif %}
                    </p>
                    <p><strong>Location:</strong> {{ conf.location }}</p>
                    {% if conf.role %}
                      <p><strong>Role:</strong> <span class="role-badge role-{{ conf.role }}">{% case conf.role %}{% when 'talk' %}🎤 Presenting Talk{% when 'poster' %}📊 Poster{% when 'attended' %}👥 Attending{% endcase %}</span></p>
                    {% endif %}
                    {% if conf.talk_title %}
                      <p><strong>Talk:</strong> {{ conf.talk_title }}</p>
                    {% endif %}
                    {% if conf.description %}
                      <p>{{ conf.description }}</p>
                    {% endif %}
                    {% if conf.url %}
                      <p><a href="{{ conf.url }}" target="_blank">Conference website</a></p>
                    {% endif %}
                  </div>
                </details>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
    
    <!-- Past Travel Section (grouped by year with collapsible details) -->
    {% if past.size > 0 %}
      <div class="past-travel">
        <h3>Past Conferences</h3>
        <div class="conference-list">
          {% assign past_sorted = past | sort: 'start_date' | reverse %}
          {% assign years = "" | split: "" %}
          {% for conf in past_sorted %}
            {% assign y = conf.start_date | date: '%Y' %}
            {% unless years contains y %}
              {% assign years = years | push: y %}
            {% endunless %}
          {% endfor %}
          {% assign years = years | sort | reverse %}

          {% for year in years %}
            <div class="conference-year">
              <h4>{{ year }}</h4>
              <ul class="conference-names">
                {% for conf in past_sorted %}
                  {% if conf.start_date | date: '%Y' == year %}
                    <li>
                      <details class="conference-detail">
                        <summary>
                          {% if conf.url %}
                            <a href="{{ conf.url }}" target="_blank">{{ conf.name }}</a>
                          {% else %}
                            {{ conf.name }}
                          {% endif %}
                          <span class="conference-mini-date"> — 
                            {% if conf.end_date %}
                              {% if conf.start_date | date: '%Y%m%d' == conf.end_date | date: '%Y%m%d' %}
                                {{ conf.start_date | date: '%b %d, %Y' }}
                              {% else %}
                                {{ conf.start_date | date: '%b %d' }} – {{ conf.end_date | date: '%b %d, %Y' }}
                              {% endif %}
                            {% else %}
                              {{ conf.start_date | date: '%b %d, %Y' }}
                            {% endif %}
                          </span>
                        </summary>
                        <div class="conference-details">
                          <p><strong>Dates:</strong> {{ conf.start_date | date: '%b %d, %Y' }} – {{ conf.end_date | date: '%b %d, %Y' }}</p>
                          <p><strong>Location:</strong> {{ conf.location }}</p>
                          {% if conf.role %}
                            <p><strong>Role:</strong> <span class="role-badge role-{{ conf.role }}">{% case conf.role %}{% when 'talk' %}🎤 Presented Talk{% when 'poster' %}📊 Poster{% when 'attended' %}👥 Attended{% endcase %}</span></p>
                          {% endif %}
                          {% if conf.talk_title %}
                            <p><strong>Talk:</strong> {{ conf.talk_title }}</p>
                          {% endif %}
                          {% if conf.description %}
                            <p>{{ conf.description }}</p>
                          {% endif %}
                          {% if conf.url %}
                            <p><a href="{{ conf.url }}" target="_blank">Conference website</a></p>
                          {% endif %}
                        </div>
                      </details>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    
    <!-- No travel message -->
    {% if upcoming.size == 0 and past.size == 0 %}
      <p>No conferences logged yet.</p>
    {% endif %}
  {% else %}
    <p>No conference data available.</p>
  {% endif %}
</div>
