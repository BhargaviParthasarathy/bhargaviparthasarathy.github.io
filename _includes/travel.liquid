<div class="travel-log">
  {% if site.travel %}
    {% assign today_date = "now" | date: "%Y-%m-%d" %}
    {% assign upcoming_list = "" | split: "" %}
    {% assign past_years = site.travel | sort: "name" | reverse %}
    
    <!-- Legend/Key -->
    <div class="travel-legend" style="float: right; margin-left: 2rem; margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--global-divider-color); border-radius: 6px; background: var(--global-bg-color); max-width: 200px;">
      <div style="font-size: 0.85rem; line-height: 1.8;">
        <div style="display: flex; align-items: center;"><span style="display: inline-block; width: 2em; text-align: center;">🎤</span><span style="text-align: left;">Research talk</span></div>
        <div style="display: flex; align-items: center;"><span style="display: inline-block; width: 2em; text-align: center;">📊</span><span style="text-align: left;">Poster presentation</span></div>
        <div style="display: flex; align-items: center;"><span style="display: inline-block; width: 2em; text-align: center;">👥</span><span style="text-align: left;">Attendance</span></div>
        <div style="display: flex; align-items: center;"><span style="display: inline-block; width: 2em; text-align: center;">*</span><span style="text-align: left;">Virtual</span></div>
      </div>
    </div>
    
    <!-- Extract all upcoming and past conferences -->
    {% for year_doc in past_years %}
      {% if year_doc.conferences %}
        {% for conf in year_doc.conferences %}
          {% assign start_date_str = conf.start_date | date: "%Y-%m-%d" %}
          {% if start_date_str >= today_date %}
            {% assign upcoming_list = upcoming_list | push: conf %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}

{% assign past_count = 0 %}
{% for year_doc in past_years %}
  {% if year_doc.conferences %}
    {% for conf in year_doc.conferences %}
      {% assign start_date_str = conf.start_date | date: "%Y-%m-%d" %}
      {% if start_date_str < today_date %}
        {% assign past_count = past_count | plus: 1 %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
    
    <!-- Upcoming Travel Section -->
    {% if upcoming_list.size > 0 %}
      <div class="upcoming-travel">
        <h3>Upcoming</h3>
        <div class="conference-list">
          {% assign upcoming_sorted = upcoming_list | sort: 'start_date' %}
          {% for conf in upcoming_sorted %}
            {% assign start_month = conf.start_date | date: '%m' %}
            {% assign end_month = conf.end_date | date: '%m' %}
            {% capture date_label %}
              {% if conf.end_date %}
                {% if start_month == end_month %}
                  {{ conf.start_date | date: '%b %-d' }}–{{ conf.end_date | date: '%-d' }}
                {% else %}
                  {{ conf.start_date | date: '%b %-d' }}–{{ conf.end_date | date: '%b %-d' }}
                {% endif %}
              {% else %}
                {{ conf.start_date | date: '%b %-d' }}
              {% endif %}
            {% endcapture %}
            {% assign conf_year = conf.start_date | date: "%Y" %}
            <div class="conference-item">
              {% if conf.role == 'attended' %}
                <div class="conference-attended">
                  <span class="conference-line">
                    <span class="conference-icon" aria-hidden="true">
                      👥
                    </span>
                    <span class="conference-name">
                      {% if conf.url %}<a href="{{ conf.url }}" target="_blank" rel="noopener">{{ conf.name }}</a>{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}, {{ conf_year }}{% else %}{{ conf.name }}{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}, {{ conf_year }}{% endif %}
                    </span>
                  </span>
                </div>
              {% else %}
                <details class="conference-detail">
                  <summary>
                    <span class="conference-line">
                      <span class="conference-icon" aria-hidden="true">
                        {% case conf.role %}
                          {% when 'talk' %}🎤
                          {% when 'poster' %}📊
                          {% else %}📍
                        {% endcase %}
                      </span>
                      <span class="conference-name">
                        {% if conf.url %}<a href="{{ conf.url }}" target="_blank" rel="noopener">{{ conf.name }}</a>{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}, {{ conf_year }}{% else %}{{ conf.name }}{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}, {{ conf_year }}{% endif %}
                      </span>
                    </span>
                  </summary>
                  <div class="conference-details">
                    {% if conf.talk_title %}
                      <p><strong>Talk:</strong> {{ conf.talk_title }}</p>
                    {% endif %}
                    {% if conf.description %}
                      <p>{{ conf.description }}</p>
                    {% endif %}
                  </div>
                </details>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    
    <!-- Past Travel Section (grouped by year) -->
    <div class="past-travel">
      <h3>Past</h3>
      <div class="conference-list">
        {% assign past_year_count = 0 %}
        {% for year_doc in past_years %}
  {% if year_doc.conferences %}
    {% assign sorted_confs = year_doc.conferences | sort: 'start_date' | reverse %}

    {%- comment -%}Check if this year has any past conferences{%- endcomment -%}
    {% assign has_past_in_year = false %}
    {% for conf in sorted_confs %}
      {% assign start_date_str = conf.start_date | date: "%Y-%m-%d" %}
      {% if start_date_str < today_date %}
        {% assign has_past_in_year = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_past_in_year %}
      {% assign past_year_count = past_year_count | plus: 1 %}
      <div class="conference-year">
        <details class="year-details"{% if past_year_count <= 3 %} open{% endif %}>
          <summary>
            <h4 style="display: inline;">{{ year_doc.year }}</h4>
          </summary>
          <div class="conference-names">
            {% for conf in sorted_confs %}
              {% assign start_date_str = conf.start_date | date: "%Y-%m-%d" %}
              {% if start_date_str < today_date %}
                {% assign start_month = conf.start_date | date: '%m' %}
                {% assign end_month = conf.end_date | date: '%m' %}
                {% capture date_label %}
                  {% if conf.end_date %}
                    {% if start_month == end_month %}
                      {{ conf.start_date | date: '%b %-d' }}–{{ conf.end_date | date: '%-d' }}
                    {% else %}
                      {{ conf.start_date | date: '%b %-d' }}–{{ conf.end_date | date: '%b %-d' }}
                    {% endif %}
                  {% else %}
                    {{ conf.start_date | date: '%b %-d' }}
                  {% endif %}
                {% endcapture %}
                <div class="conference-item">
                  {% if conf.role == 'attended' %}
                    <div class="conference-attended">
                      <span class="conference-line">
                        <span class="conference-icon" aria-hidden="true">
                          👥
                        </span>
                        <span class="conference-name">
                          {% if conf.url %}<a href="{{ conf.url }}" target="_blank" rel="noopener">{{ conf.name }}</a>{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}{% else %}{{ conf.name }}{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}{% endif %}
                        </span>
                      </span>
                    </div>
                  {% else %}
                    <details class="conference-detail">
                      <summary>
                        <span class="conference-line">
                          <span class="conference-icon" aria-hidden="true">
                            {% case conf.role %}
                              {% when 'talk' %}🎤
                              {% when 'poster' %}📊
                              {% else %}📍
                            {% endcase %}
                          </span>
                          <span class="conference-name">
                            {% if conf.url %}<a href="{{ conf.url }}" target="_blank" rel="noopener">{{ conf.name }}</a>{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}{% else %}{{ conf.name }}{% if conf.virtual %}*{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %} – {{ date_label | strip }}{% endif %}
                          </span>
                        </span>
                      </summary>
                      <div class="conference-details">
                        {% if conf.talk_title %}
                          <p><strong>Talk:</strong> {{ conf.talk_title }}</p>
                        {% endif %}
                        {% if conf.description %}
                          <p>{{ conf.description }}</p>
                        {% endif %}
                      </div>
                    </details>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </details>
      </div>
    {% endif %}
  {% endif %}
{% endfor %}
     </div>
    </div>
    
    <!-- No travel message -->
    {% if upcoming_list.size == 0 and past_count == 0 %}
  <p>No conferences logged yet.</p>
{% endif %}
  {% else %}
    <p>No conference data available.</p>
  {% endif %}
</div>
